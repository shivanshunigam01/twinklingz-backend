# Server (use 5010 on VPS if port 5000 is already used by another PM2 app)
PORT=5000
NODE_ENV=development
# Comma-separated storefront origins. https://twinklingz.com and https://www.twinklingz.com are always allowed in code.
# In development, localhost / 127.0.0.1 on any port are also allowed.
CLIENT_URL=http://localhost:5173,http://localhost:8080,https://twinklingz.com,https://www.twinklingz.com

# MongoDB — full URI or user + password (recommended if password has @ # %)
MONGODB_URI=
MONGODB_USER=your_atlas_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_HOST=twinkliz.3histwf.mongodb.net
MONGODB_DB=

# Admin JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin (used by npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (URL or separate fields)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=twinklingz

# Razorpay (secret stays on server only — never commit real keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret

# Storefront (links in order emails; defaults to first https URL in CLIENT_URL)
STOREFRONT_URL=https://twinklingz.com

# SMTP (order confirmation after successful payment)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=orders@twinklingz.com
