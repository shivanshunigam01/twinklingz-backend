# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB — full URI or user + password (recommended if password has @ # %)
MONGODB_URI=
MONGODB_USER=your_atlas_db_user
MONGODB_PASSWORD=your_db_password
MONGODB_HOST=twinkliz.3histwf.mongodb.net
MONGODB_DB=

# Admin JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# First admin (used by npm run seed:admin)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudinary (URL or separate fields)
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=twinklingz

# Razorpay (secret stays on server only — never commit real keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
